pipeline {
    agent any

    environment {
        DOCKER_IMAGE   = 'cloudops-sentinel-backend'
        REGISTRY       = 'registry.example.com'
        DEPLOY_ENV     = 'dev'
        HEALTH_URL     = 'http://localhost:8080/api/v1/health'
        GO111MODULE    = 'on'
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    stages {
        // ── 1. Checkout ──────────────────────────────────────────
        stage('Checkout') {
            steps {
                checkout scm
                echo "Checked out branch: ${env.BRANCH_NAME ?: 'unknown'}"
            }
        }

        // ── 2. Unit Tests ────────────────────────────────────────
        stage('Unit Tests') {
            steps {
                dir('backend') {
                    sh 'go test ./... -v -coverprofile=coverage.out'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'backend/coverage.out', allowEmptyArchive: true
                }
            }
        }

        // ── 3. Static Analysis ───────────────────────────────────
        stage('Static Analysis') {
            steps {
                echo 'Running static analysis...'
                // e.g. sh 'golangci-lint run ./backend/...'
            }
        }

        // ── 4. Dependency / Filesystem Scan ──────────────────────
        stage('Dependency Scan') {
            steps {
                sh 'trivy fs --scanners vuln --severity CRITICAL,HIGH --exit-code 0 --format json --output trivy-fs.json ./backend'
            }
        }

        // ── 5. Secret Detection ──────────────────────────────────
        stage('Secret Detection') {
            steps {
                sh 'trivy fs --scanners secret --severity CRITICAL,HIGH --exit-code 0 --format json --output trivy-secrets.json .'
            }
        }

        // ── 6. Docker Build ──────────────────────────────────────
        stage('Docker Build') {
            steps {
                sh "docker build -t ${DOCKER_IMAGE}:${env.BUILD_NUMBER} ./backend"
                sh "docker tag ${DOCKER_IMAGE}:${env.BUILD_NUMBER} ${DOCKER_IMAGE}:latest"
            }
        }

        // ── 7. Container Scan ────────────────────────────────────
        stage('Container Scan') {
            steps {
                sh "trivy image --scanners vuln --severity CRITICAL,HIGH --exit-code 0 --format json --output trivy-image.json ${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
            }
        }

        // ── 8. IaC Validation ────────────────────────────────────
        stage('IaC Validation') {
            steps {
                sh 'terraform -chdir=infrastructure/terraform/aws-complete fmt -check'
                sh 'terraform -chdir=infrastructure/terraform/aws-complete init -backend=false -input=false'
                sh 'terraform -chdir=infrastructure/terraform/aws-complete validate'
            }
        }

        // ── 9. Security Gate ─────────────────────────────────────
        // Reads the Trivy JSON reports and FAILS the build when any CRITICAL
        // vulnerability is present (the project's own security-policy.yaml).
        stage('Security Gate') {
            steps {
                script {
                    echo 'Evaluating security gate (zero CRITICAL CVEs / secrets)...'
                    def finding = sh(
                        script: '''
                            python3 - <<'PY'
import json, sys
failed = False
for path in ("trivy-image.json", "trivy-fs.json", "trivy-secrets.json"):
    try:
        with open(path, encoding="utf-8") as f:
            doc = json.load(f)
    except FileNotFoundError:
        continue
    for result in doc.get("Results", []):
        for vuln in result.get("Vulnerabilities", []) or []:
            if vuln.get("Severity") == "CRITICAL":
                print("CRITICAL: %s in %s (%s)" % (vuln.get("VulnerabilityID"), result.get("Target"), path))
                failed = True
        for secret in result.get("Secrets", []) or []:
            print("SECRET: %s in %s" % (secret.get("RuleID"), result.get("Target")))
            failed = True
sys.exit(1 if failed else 0)
PY
                        ''',
                        returnStatus: true,
                    )
                    if (finding != 0) {
                        error 'Security gate FAILED — CRITICAL CVEs or secrets detected.'
                    }
                    echo 'Security gate PASSED.'
                }
            }
        }

        // ── 10. Image Push ───────────────────────────────────────
        stage('Image Push') {
            steps {
                echo "Pushing image to registry ${REGISTRY}..."
                // e.g. sh "docker push ${REGISTRY}/${DOCKER_IMAGE}:${env.BUILD_NUMBER}"
            }
        }

        // ── 11. Deploy ───────────────────────────────────────────
        stage('Deploy') {
            steps {
                echo "Deploying to environment: ${DEPLOY_ENV}..."
                // e.g. sh "kubectl set image deployment/cloudops-sentinel-backend ..."
            }
        }

        // ── 12. Health Check ─────────────────────────────────────
        stage('Health Check') {
            steps {
                echo 'Running post-deployment health check...'
                sh "curl -sf ${HEALTH_URL} || echo 'Health check endpoint not reachable (non-fatal in CI)'"
            }
        }

        // ── 13. Monitor ──────────────────────────────────────────
        stage('Monitor') {
            steps {
                echo 'Verifying monitoring and alerting stack...'
                // e.g. sh 'curl -sf http://prometheus:9090/-/healthy'
            }
        }
    }

    post {
        always {
            echo 'Pipeline execution finished.'
            archiveArtifacts artifacts: 'trivy-*.json', allowEmptyArchive: true
            cleanWs()
        }
        success {
            echo '✅ Pipeline SUCCEEDED — all stages passed.'
            // e.g. slackSend channel: '#deployments', message: "Build #${env.BUILD_NUMBER} succeeded"
        }
        failure {
            echo '❌ Pipeline FAILED — check logs above for details.'
            // e.g. slackSend channel: '#deployments', color: 'danger', message: "Build #${env.BUILD_NUMBER} failed"
        }
    }
}
